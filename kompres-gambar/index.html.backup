<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Kompres Gambar Online Gratis - Resize & Compress Foto</title>

  <meta name="description"
    content="Kompres gambar JPG, PNG, dan WebP langsung di browser tanpa upload ke server. Gratis, aman, tanpa watermark." />

  <meta name="robots" content="index, follow" />
  <link rel="stylesheet" href="../asset/css/donate.css"/>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 0;
      color: #222;
    }

    header {
      background: white;
      padding: 30px 20px;
      text-align: center;
    }

    .container {
      max-width: 900px;
      margin: auto;
      padding: 20px;
    }

    .box,
    .content {
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      margin-bottom: 20px;
    }

    input[type="file"],
    input[type="number"],
    input[type="range"] {
      width: 100%;
      margin: 10px 0;
    }

    button {
      background: #007bff;
      color: white;
      border: none;
      padding: 12px 15px;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 10px;
      width: 100%;
    }

    button:hover {
      background: #0056b3;
    }

    .info {
      margin-top: 10px;
      font-size: 14px;
      color: #555;
      line-height: 1.6;
    }

    .preview {
      max-width: 100%;
      margin-top: 15px;
      border-radius: 10px;
    }

    footer {
      text-align: center;
      padding: 30px;
      font-size: 14px;
      color: #777;
    }

    .slider-value {
      font-weight: bold;
      color: #007bff;
    }
  </style>
</head>

<body>

<header>
  <h1>Kompres Gambar Online Gratis</h1>
  <p>Kompres JPG, PNG, dan WebP langsung di browser tanpa upload ke server</p>
</header>

<div class="container">

  <!-- TOOL -->

  <div class="box">

    <h2>Kompres Gambar</h2>

    <input type="file" id="imgInput" accept="image/*" />

    <label>
      Quality:
      <span class="slider-value" id="qualityValue">70%</span>
    </label>

    <input
      type="range"
      id="quality"
      min="10"
      max="100"
      step="5"
      value="70"
    />

    <label>Max Width</label>

    <input type="number" id="maxWidth" value="1200" />

    <div class="info">
      <div>Width: <span id="imgWidth">-</span></div>
      <div>Height: <span id="imgHeight">-</span></div>
      <div>Ukuran asli: <span id="originalSize">-</span></div>
      <div>Estimasi ukuran: <span id="estimatedSize">-</span></div>
    </div>

    <button onclick="compressImage()">
      Kompres & Download
    </button>

    <div class="info" id="compressResult"></div>

    <img id="preview" class="preview" />

  </div>

  <!-- CONTENT -->

  <div class="content">

    <h2>Apa itu Kompres Gambar?</h2>

    <p>
      Kompres gambar online adalah proses mengecilkan ukuran file gambar
      tanpa perlu menginstall aplikasi tambahan.
    </p>

    <p>
      Tool ini bekerja langsung di browser sehingga gambar tidak diupload ke server.
      Lebih aman, cepat, dan gratis digunakan.
    </p>

    <h3>Cara menggunakan:</h3>

    <ol>
      <li>Upload gambar JPG, PNG, atau WebP</li>
      <li>Atur kualitas kompresi</li>
      <li>Atur ukuran lebar maksimal jika diperlukan</li>
      <li>Klik tombol Kompres & Download</li>
      <li>File otomatis terdownload</li>
    </ol>

  </div>

</div>

<footer>
  © 2026 Tools Online Gratis
</footer>

<div id="donation-popup"></div>

<!-- CDN -->

<script src="https://cdn.jsdelivr.net/npm/browser-image-compression@latest/dist/browser-image-compression.js"></script>
<script src="../asset/js/include.js"></script>
<script src="../asset/js/donate.js"></script>

<script>

const imgInput = document.getElementById('imgInput');
const qualitySlider = document.getElementById('quality');

let currentFile = null;

function formatBytes(bytes) {

  if (bytes < 1024) return bytes + ' B';

  if (bytes < 1024 * 1024)
    return (bytes / 1024).toFixed(2) + ' KB';

  return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
}

/* REALTIME QUALITY */

qualitySlider.addEventListener('input', updateRealtimeInfo);

imgInput.addEventListener('change', async () => {

  currentFile = imgInput.files[0];

  if (!currentFile) return;

  document.getElementById('originalSize').innerText =
    formatBytes(currentFile.size);

  const img = new Image();

  img.onload = function () {

    document.getElementById('imgWidth').innerText =
      img.width + ' px';

    document.getElementById('imgHeight').innerText =
      img.height + ' px';
  };

  img.src = URL.createObjectURL(currentFile);

  updateRealtimeInfo();
});

function updateRealtimeInfo() {

  const quality = qualitySlider.value;

  document.getElementById('qualityValue').innerText =
    quality + '%';

  if (!currentFile) return;

  /* estimasi sederhana */

  const estimated =
    currentFile.size * (quality / 100);

  document.getElementById('estimatedSize').innerText =
    formatBytes(estimated);
}

async function compressImage() {

  const file = imgInput.files[0];

  if (!file) {
    alert('Pilih gambar terlebih dahulu');
    return;
  }

  const quality =
    parseInt(qualitySlider.value) / 100;

  const maxWidth =
    parseInt(document.getElementById('maxWidth').value);

  const options = {
    maxSizeMB: 5,
    maxWidthOrHeight: maxWidth,
    useWebWorker: true,
    initialQuality: quality
  };

  try {

    document.getElementById('compressResult').innerText =
      'Mengompres gambar...';

    const compressedFile =
      await imageCompression(file, options);

    const url =
      URL.createObjectURL(compressedFile);

    document.getElementById('preview').src = url;

    document.getElementById('compressResult').innerText =
      `Berhasil dikompres: ${formatBytes(compressedFile.size)}
       dari ${formatBytes(file.size)}`;

    const a = document.createElement('a');

    a.href = url;

    a.download = 'compressed-image.jpg';

    a.click();

  } catch (err) {

    console.error(err);

    alert('Gagal mengompres gambar');
  }
}

include("donate.html", "#donation-popup");
</script>

</body>
</html>

